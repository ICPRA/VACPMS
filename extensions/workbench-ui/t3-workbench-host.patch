+    expect(JSON.stringify(renderer.toJSON())).toContain("not their merge base");
+    expect(persist).not.toHaveBeenCalled();
+    await act(async () => renderer.update(<WorkbenchDeliveryGit run={run} snapshot={{ git: { ...git, workspace: "C:/other" } }} />));
