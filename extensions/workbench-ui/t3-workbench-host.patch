diff --git a/apps/desktop/src/ipc/methods/workbench.ts b/apps/desktop/src/ipc/methods/workbench.ts
new file mode 100644
--- /dev/null
+++ b/apps/desktop/src/ipc/methods/workbench.ts
@@ -0,0 +1,83 @@
+import * as Effect from "effect/Effect";
+import * as FileSystem from "effect/FileSystem";
+import * as Option from "effect/Option";
+import * as Schema from "effect/Schema";
+import * as Ref from "effect/Ref";
+import * as Config from "effect/Config";
+import { commandWorkbench, readWorkbench } from "../../../../../../project-workbench/extensions/workbench-desktop/read-node.mjs";
+import { setupMail } from "../../../../../../project-workbench/extensions/workbench-desktop/setup-mail.mjs";
+import * as ElectronWindow from "../../electron/ElectronWindow.ts";
+import * as DesktopEnvironment from "../../app/DesktopEnvironment.ts";
+import { makeIpcMethod, type DesktopIpcInvokeEvent } from "../DesktopIpc.ts";
+
+class WorkbenchReadError extends Schema.TaggedError<WorkbenchReadError>()("WorkbenchReadError", { message: Schema.String }) {}
+
+const ensureMainWindow = Effect.fn("desktop.ipc.workbench.sender")(function* (event: DesktopIpcInvokeEvent | undefined) {
+  const main = yield* (yield* ElectronWindow.ElectronWindow).main;
+  if (!event || Option.isNone(main) || main.value.webContents.id !== event.sender.id) {
+    return yield* new WorkbenchReadError({ message: "Workbench request rejected" });
+  }
+});
+
+const readRuntime = Effect.gen(function* () {
+  const environment = yield* DesktopEnvironment.DesktopEnvironment;
+  const fileSystem = yield* FileSystem.FileSystem;
+  const configuredHome = yield* Config.String("VACPMS_HOME").pipe(Config.option);
+  const home = Option.getOrElse(configuredHome, () => environment.path.join(environment.homeDirectory, "project-workbench"));
+  const raw = yield* fileSystem.readFileString(environment.path.join(home, "desktop-runtime.json"));
+  const settings = yield* Schema.decodeUnknownEffect(Schema.fromJsonString(Schema.Struct({ executable: Schema.NonEmptyString, config: Schema.NonEmptyString })))(raw);
+  return { executable: environment.path.resolve(home, settings.executable), config: environment.path.resolve(home, settings.config) };
+});
+
+export const makeWorkbenchReadMethod = Effect.gen(function* () {
+  let mailboxSetup: ReturnType<typeof setupMail> | undefined;
+  const operatorCredential = yield* Ref.make<string | undefined>(undefined);
+  yield* Effect.addFinalizer(() => Ref.set(operatorCredential, undefined));
+  const read = makeIpcMethod({
+  channel: "vacpms:read-node",
+  payload: Schema.Struct({ resource: Schema.Literals(["projects", "current-view", "spec", "mail-identity", "mail-threads", "mail-thread", "mail-signout", "operator-identity", "operator-signout", "dependencies", "run-context", "run-dispatch", "delivery", "knowledge-search", "knowledge-spec", "knowledge-decision", "knowledge-change", "node-mark-history", "change-preview"]), project: Schema.optional(Schema.NonEmptyString), slug: Schema.optional(Schema.NonEmptyString), credential: Schema.optional(Schema.NonEmptyString), taskSlug: Schema.optional(Schema.NonEmptyString), threadId: Schema.optional(Schema.NonEmptyString), state: Schema.optional(Schema.String), cursor: Schema.optional(Schema.String), query: Schema.optional(Schema.NonEmptyString) }),
+  result: Schema.Unknown,
+  handler: Effect.fn("desktop.ipc.workbench.readNode")(function* (input, event) {
+    yield* ensureMainWindow(event);
+    if (input.resource === "mail-signout" || input.resource === "operator-signout") {
+      yield* Ref.set(operatorCredential, undefined);
+      return { signedOut: true };
+    }
+    const savedCredential = yield* Ref.get(operatorCredential);
+    const needsIdentity = input.resource.startsWith("mail-") || input.resource.startsWith("run-") || input.resource.startsWith("knowledge-") || input.resource === "change-preview" || input.resource === "node-mark-history" || input.resource === "operator-identity" || input.resource === "dependencies" || input.resource === "delivery";
+    const credential = needsIdentity ? input.credential ?? savedCredential : undefined;
+    if (needsIdentity && !credential) {
+      return yield* new WorkbenchReadError({ message: "unauthorized: sign in to use this operation" });
+    }
+    const { executable, config } = yield* readRuntime;
+    const resource = input.resource;
+    const result = yield* Effect.tryPromise({ try: (signal) => readWorkbench({ ...input, resource, credential, executable, config }, signal), catch: (cause) => new WorkbenchReadError({ message: cause instanceof Error ? cause.message : "Local workbench read failed" }) });
+    if ((resource === "mail-identity" || resource === "operator-identity") && input.credential) yield* Ref.set(operatorCredential, input.credential);
+    return result;
+  }),
+  });
+  const command = makeIpcMethod({
+    channel: "vacpms:command",
+    payload: Schema.Struct({ operation: Schema.Literals(["create-node", "approve-node", "subdivide-node", "review-delivery", "submit-delivery", "set-node-mark", "add-dependency", "remove-dependency", "manual-complete", "mail-setup", "prepare-run", "bind-run", "authorize-run", "resolve-run", "confirm-run-stopped", "abandon-node", "cancel-preparation", "abort-preparation"]), project: Schema.NonEmptyString, slug: Schema.optional(Schema.NonEmptyString), body: Schema.Unknown }),
+    result: Schema.Unknown,
+    handler: Effect.fn("desktop.ipc.workbench.command")(function* (input, event) {
+      yield* ensureMainWindow(event);
+      const credential = yield* Ref.get(operatorCredential);
+      if (!credential) return { error: { code: "unauthorized", message: "Sign in before submitting an operation" } };
+      const runtime = yield* readRuntime;
+      if (input.operation === "mail-setup") {
+        const environment = yield* DesktopEnvironment.DesktopEnvironment;
+        return yield* Effect.tryPromise({
+          try: () => {
+            mailboxSetup ??= setupMail({ home: environment.baseDir, runtime, credential }).finally(() => { mailboxSetup = undefined; });
+            return mailboxSetup.then((data) => ({ data }));
+          },
+          catch: (cause) => new WorkbenchReadError({ message: cause instanceof Error ? cause.message : "Mailbox setup failed" }),
+        });
+      }
+      const operation = input.operation;
+      return yield* Effect.tryPromise({ try: (signal) => commandWorkbench({ ...input, operation, ...runtime, credential }, signal), catch: (cause) => new WorkbenchReadError({ message: cause instanceof Error ? cause.message : "Local command outcome unconfirmed" }) });
+    }),
+  });
+  return { read, command };
+});
