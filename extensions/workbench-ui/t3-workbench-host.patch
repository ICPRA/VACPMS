+
+export function WorkbenchSessions({
+  runs,
+  selectedTask,
+  selectedRunId,
+  project,
+  onChanged,
+  request,
+  nodeOwners,
+}: {
+  runs: readonly WorkbenchRun[];
+  selectedTask: string | null;
+  selectedRunId?: string;
+  project: string;
+  onChanged: () => void;
+  request?: WorkbenchRequest;
+  nodeOwners?: Array<{ taskSlug: string; humanOwnerUserId: string | null; pendingOperationId: string | null }>;
+}) {
+  const { language } = useI18n();
+  const zh = language === "zh";
+  const projects = useProjects();
+  const threads = useThreadShells();
+  const snapshotsReady = useAllEnvironmentProjectSnapshotsReady();
+  const visibleRuns = runs.filter((run) => (!selectedTask || run.taskSlug === selectedTask) && (!selectedRunId || run.id === selectedRunId));
+  const associations = new Map(runs.map((run) => [run.id, matchWorkbenchRun(run, threads, projects, snapshotsReady)]));
+  const siblings = new Map<string, WorkbenchRun[]>();
+  for (const run of runs) {
+    const match = associations.get(run.id)!;
+    if (match.kind !== "matched") continue;
+    const key = `${match.thread.environmentId}:${match.thread.id}`;
+    const group = siblings.get(key) ?? [];
+    group.push(run); siblings.set(key, group);
+  }
+  return (
+    <section className="min-w-0" data-i18n-skip>
+      {!snapshotsReady && visibleRuns.some((run) => run.executorKind !== "program") ? (
+        <p
+          role="status"
+          className="mb-3 flex items-start gap-2 text-sm text-amber-600 dark:text-amber-400"
+        >
+          <CircleAlert className="mt-0.5 size-4 shrink-0" aria-hidden="true" />
+          {zh
+            ? "部分 T3 环境尚未同步，会话关联可能不完整。"
+            : "Some T3 environments are not synchronized; session links may be incomplete."}
+        </p>
+      ) : null}
+      {visibleRuns.length === 0 ? (
+        <p className="py-6 text-sm text-muted-foreground">
+          {zh ? "当前范围没有已登记的执行。" : "No registered runs in this scope."}
+        </p>
+      ) : (
+        visibleRuns.map((run) => {
+          const match = associations.get(run.id)!;
+          if (match.kind === "program")
+            return <WorkbenchProgramRunRow key={run.id} run={run} project={project} onChanged={onChanged}
+              ownerHold={nodeOwners?.some((item) => item.taskSlug === run.taskSlug && (!!item.humanOwnerUserId || !!item.pendingOperationId)) ?? false}
+              {...(request ? { request } : {})} />;
+          if (match.kind === "matched")
+            return <SessionRow key={run.id} run={run} thread={match.thread} siblingRuns={siblings.get(`${match.thread.environmentId}:${match.thread.id}`)!} project={project} onChanged={onChanged} {...(request ? { request } : {})} />;
+          const label = {
+            unbound: zh ? "尚未绑定会话" : "Session not bound",
+            "missing-workspace": zh
+              ? "缺少工作目录，无法核对关联"
+              : "Workspace missing; link unverified",
+            unresolved: zh
+              ? "无法核对会话引用与工作目录"
+              : "Session reference and workspace not resolved",
+            ambiguous: zh ? "多个环境匹配，关联有歧义" : "Ambiguous match across environments",
+            synchronizing: zh
+              ? "环境快照未齐，尚不能核实唯一关联"
+              : "Environment snapshots incomplete; unique link unverified",
+          }[match.kind];
+          return (
+            <article key={run.id} className="space-y-1 border-b py-4 text-sm">
+              <p className="break-all font-medium">{run.taskSlug}</p>
+              <RunHarness project={project} run={run} language={language} {...(request ? { request } : {})} />
+              <p className="text-xs text-muted-foreground">{zh ? "派单职责" : "Assigned responsibility"}: {run.assignmentRole ? (assignmentLabels[run.assignmentRole]?.[zh ? 0 : 1] ?? run.assignmentRole) : (zh ? "未记录" : "Not recorded")}</p>
+              <p className="text-amber-600 dark:text-amber-400">{label}</p>
+              <p className="break-all text-xs text-muted-foreground">
+                {run.id} · {zh ? "业务绑定" : "Binding"}: {run.state}
+              </p>
+              <p className="text-xs text-muted-foreground">
+                {zh ? "准备时规格版本" : "Spec version at preparation"}: {run.specVersion == null ? (zh ? "未记录" : "Not recorded") : `v${run.specVersion}`}
+              </p>
+              {run.threadRef ? (
+                <p className="break-all text-xs text-muted-foreground">{run.threadRef}</p>
+              ) : null}
+              {run.workspace ? (
+                <p className="break-all text-xs text-muted-foreground">{run.workspace}</p>
+              ) : null}
+            </article>
+          );
+        })
+      )}
+    </section>
+  );
+}
