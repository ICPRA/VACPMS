+          ? (zh ? "非Git目录" : "Not a Git repository")
+          : run.gitBaseline?.isRepo === true ? (run.gitBaseline.commitSha ?? (zh ? "未取得可解析的HEAD提交" : "No resolvable HEAD commit"))
+            : (zh ? "未记录" : "Not recorded")}</p>
+        <p className="break-all text-xs text-muted-foreground">
