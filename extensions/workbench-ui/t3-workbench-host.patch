+import {
+  EnvironmentId, MessageId, ProjectId, ProviderInstanceId, ThreadId,
+  type OrchestrationSearchThreadsInput, type OrchestrationThreadShell,
+} from "@t3tools/contracts";
+import { expect, it } from "@effect/vitest";
+import * as Context from "effect/Context";
+import * as Effect from "effect/Effect";
+import * as Layer from "effect/Layer";
+import * as Option from "effect/Option";
+import * as Stream from "effect/Stream";
+import { Tool } from "effect/unstable/ai";
+
+import { ProjectionSnapshotQuery } from "../orchestration/Services/ProjectionSnapshotQuery.ts";
+import { PersistenceSqlError } from "../persistence/Errors.ts";
+import { McpInvocationContext, type McpInvocationScope } from "./McpInvocationContext.ts";
+import { WorkbenchKnowledgeHandlersLive, WorkbenchKnowledgeToolkit } from "./workbenchKnowledge.ts";
+
+const invocation: McpInvocationScope = {
+  environmentId: EnvironmentId.make("native-environment"),
+  threadId: ThreadId.make("native-thread"),
+  providerSessionId: "native-session",
+  providerInstanceId: ProviderInstanceId.make("codex"),
+  capabilities: new Set(),
+  issuedAt: 1,
+};
+const projectId = ProjectId.make("native-project");
+// Only project identity and archive state are consumed from the native shell.
+const thread = { projectId, archivedAt: null } as OrchestrationThreadShell;
+
+it.effect("reads the exact source message using authenticated project scope and explicit continuation", () => Effect.gen(function* () {
+  const source = { projectId, threadId: ThreadId.make("source-thread"), messageId: MessageId.make("source-message"),
+    source: "assistant" as const, text: "Original text", offset: 0, nextOffset: 6000,
+    createdAt: "2026-09-23T00:00:00.000Z", updatedAt: "2026-09-23T00:00:00.000Z" };
+  const snapshots = Layer.mock(ProjectionSnapshotQuery)({
+    getThreadShellById: () => Effect.succeed(Option.some(thread)),
+    readProjectConversationMessage: (input) => {
+      expect(input).toEqual({ projectId, threadId: source.threadId, messageId: source.messageId, offset: 0, maxCharacters: 6000 });
+      return Effect.succeed(Option.some(source));
+    },
+  });
+  const built = yield* WorkbenchKnowledgeToolkit.pipe(Effect.provide(WorkbenchKnowledgeHandlersLive.pipe(Layer.provide(snapshots))));
+  const results = yield* built.handle("workbench_read_conversation_message", { threadId: source.threadId, messageId: source.messageId, projectId: "forged" } as never).pipe(
+    Stream.unwrap, Stream.runCollect, Effect.provideService(McpInvocationContext, invocation),
+  );
+  expect(results.at(-1)?.result).toEqual(source);
+}));
+
+it.effect("derives conversation scope from authentication and ignores model identity", () => Effect.gen(function* () {
+  const requests: OrchestrationSearchThreadsInput[] = [];
+  const matches = [{
+    threadId: ThreadId.make("source-thread"), projectId, source: "user" as const,
+    snippet: "Original source excerpt", messageCreatedAt: "2026-09-23T00:00:00.000Z",
+  }];
+  const snapshots = Layer.mock(ProjectionSnapshotQuery)({
+    getThreadShellById: (id) => {
+      expect(id).toBe(invocation.threadId);
+      return Effect.succeed(Option.some(thread));
+    },
+    searchThreads: (input) => {
+      requests.push(input);
+      return Effect.succeed({ matches });
+    },
+  });
+  const built = yield* WorkbenchKnowledgeToolkit.pipe(
+    Effect.provide(WorkbenchKnowledgeHandlersLive.pipe(Layer.provide(snapshots))),
+  );
+  const call = (payload: unknown) => built.handle("workbench_search_conversations", payload as never).pipe(
+    Stream.unwrap, Stream.runCollect, Effect.provideService(McpInvocationContext, invocation),
+  );
+  const result = yield* call({ query: "source" });
+  expect(requests).toEqual([{ projectId, query: "source", includeArchived: true, limit: 20 }]);
+  expect(result.at(-1)?.result).toEqual({
+    scope: "t3-project-conversations", projectId, matches, limit: 20,
+    includeArchived: true, oneMatchPerThread: true,
+  });
+  yield* call({ query: "source", includeArchived: false, limit: 1 });
+  expect(requests[1]).toEqual({ projectId, query: "source", includeArchived: false, limit: 1 });
+  for (const field of ["projectId", "threadId", "environmentId", "providerSessionId", "unknown"]) {
+    yield* call({ query: "source", [field]: "forged" });
+    expect(requests.at(-1)).toEqual({ projectId, query: "source", includeArchived: true, limit: 20 });
+  }
+  expect(requests).toHaveLength(7);
+  const tool = WorkbenchKnowledgeToolkit.tools.workbench_search_conversations;
+  expect(Object.keys(Tool.getJsonSchema(tool).properties ?? {})).toEqual(["query", "includeArchived", "limit"]);
+  expect(Context.get(tool.annotations, Tool.Readonly)).toBe(true);
+  expect(Context.get(tool.annotations, Tool.Destructive)).toBe(false);
+  expect(Context.get(tool.annotations, Tool.Idempotent)).toBe(true);
+  expect(Context.get(tool.annotations, Tool.OpenWorld)).toBe(false);
+}));
+
+it.effect("fails explicitly for missing or archived invocation and failed search", () => Effect.gen(function* () {
+  for (const value of [null, { ...thread, archivedAt: "2026-09-23T00:00:00.000Z" }, thread]) {
+    const snapshots = Layer.mock(ProjectionSnapshotQuery)({
+      getThreadShellById: () => Effect.succeed(Option.fromNullishOr(value)),
+      searchThreads: () => Effect.fail(new PersistenceSqlError({ operation: "search fixture", cause: "unavailable" })),
+    });
+    const built = yield* WorkbenchKnowledgeToolkit.pipe(
+      Effect.provide(WorkbenchKnowledgeHandlersLive.pipe(Layer.provide(snapshots))),
+    );
+    const failure = yield* built.handle("workbench_search_conversations", { query: "source" }).pipe(
+      Stream.unwrap, Stream.runCollect, Effect.provideService(McpInvocationContext, invocation), Effect.flip,
+    );
+    expect(failure.message).toBe(value === thread
+      ? "Conversation search failed"
+      : "Conversation search requires an active invoking thread");
+  }
+}));
diff --git a/apps/web/src/components/workbench/WorkbenchWorkspacePicker.tsx b/apps/web/src/components/workbench/WorkbenchWorkspacePicker.tsx
new file mode 100644
--- /dev/null
+++ b/apps/web/src/components/workbench/WorkbenchWorkspacePicker.tsx
@@ -0,0 +1,128 @@
+import { useRef, useState } from "react";
+import type { EnvironmentProject } from "@t3tools/client-runtime/state/shell";
+import { squashAtomCommandFailure } from "@t3tools/client-runtime/state/runtime";
+import { normalizeProjectPathForComparison } from "@t3tools/shared/path";
+import { ChevronDown, GitBranchPlus, RefreshCw } from "lucide-react";
+import { Button } from "~/components/ui/button";
+import { Input } from "~/components/ui/input";
+import { useI18n } from "~/i18n/i18n";
+import { usePaginatedBranches } from "~/state/queries";
+import { useAtomCommand } from "~/state/use-atom-command";
+import { vcsEnvironment } from "~/state/vcs";
+
+export type WorkbenchWorkspaceSelection = {
+  workspace: string;
+  branch: string | null;
+  worktreePath: string | null;
+};
+
+type Props = {
+  nativeProject: EnvironmentProject;
+  value: WorkbenchWorkspaceSelection | null;
+  disabled: boolean;
+  onChange: (value: WorkbenchWorkspaceSelection | null) => void;
+};
+
+export function WorkbenchWorkspacePicker({ nativeProject, value, disabled, onChange }: Props) {
+  const { language } = useI18n();
+  const text = (zh: string, en: string) => language === "zh" ? zh : en;
+  const [query, setQuery] = useState("");
+  const [base, setBase] = useState("");
+  const [branch, setBranch] = useState("");
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState("");
+  const inFlight = useRef(false);
+  const refs = usePaginatedBranches({
+    environmentId: nativeProject.environmentId,
+    cwd: nativeProject.workspaceRoot,
+    query,
+  });
+  const createWorktree = useAtomCommand(vcsEnvironment.createWorktree, { reportFailure: false });
+  const rootPath = normalizeProjectPathForComparison(nativeProject.workspaceRoot);
+  const gitReady = refs.data !== null && refs.data.isRepo && !refs.error;
+  const worktrees = gitReady ? refs.refs.filter((ref) => ref.worktreePath !== null && normalizeProjectPathForComparison(ref.worktreePath) !== rootPath) : [];
+  const selection = value === null ? "" : value.worktreePath === null
+    ? "shared" : JSON.stringify([value.branch, value.worktreePath]);
+  const missingSelection = value?.worktreePath !== null && value !== null &&
+    !worktrees.some((ref) => JSON.stringify([ref.name, ref.worktreePath]) === selection);
+  const sourceError = refs.error || (refs.data !== null && !refs.data.isRepo ? text("该项目不是 Git 仓库；仍可显式选择共享目录。", "The selected project is not a Git repository. The shared directory remains available.") : "");
+  const unavailable = disabled || busy || !gitReady;
+  const canCreate = !unavailable && refs.refs.some((ref) => ref.name === base) && branch.trim() !== "";
+
+  async function createSelectedWorktree() {
+    if (!canCreate || inFlight.current) return;
+    inFlight.current = true;
+    onChange(null);
+    setBusy(true);
+    setError("");
+    try {
+      const result = await createWorktree({
+        environmentId: nativeProject.environmentId,
+        input: { cwd: nativeProject.workspaceRoot, refName: base, newRefName: branch.trim(), baseRefName: base, path: null },
+      });
+      if (result._tag !== "Success") throw squashAtomCommandFailure(result);
+      const worktree = result.value.worktree;
+      if (!worktree.path || !worktree.refName || normalizeProjectPathForComparison(worktree.path) === rootPath) {
+        throw new Error(text("原生工作树创建未返回隔离路径和分支。请检查工作树列表后再重试。", "Native worktree creation did not return an isolated path and branch. Inspect the worktree list before retrying."));
+      }
+      onChange({ workspace: worktree.path, branch: worktree.refName, worktreePath: worktree.path });
+    } catch (failure) {
+      setError(failure instanceof Error ? failure.message : String(failure));
+    } finally {
+      refs.refresh();
+      inFlight.current = false;
+      setBusy(false);
+    }
+  }
+
+  return <div className="min-w-0 space-y-3">
+    <label className="block text-sm">{text("执行工作区", "Execution workspace")}
+      <select aria-label={text("执行工作区", "Execution workspace")} className="mt-1 block w-full min-w-0 rounded border bg-background p-2"
+        value={selection} disabled={disabled || busy} onChange={(event) => {
+          if (disabled || busy) return;
+          setError("");
+          if (event.target.value === "") { onChange(null); return; }
+          if (event.target.value === "shared") {
+            onChange({ workspace: nativeProject.workspaceRoot, branch: null, worktreePath: null });
+            return;
+          }
+          const ref = worktrees.find((entry) => JSON.stringify([entry.name, entry.worktreePath]) === event.target.value);
+          if (!ref?.worktreePath) {
+            onChange(null);
+            setError(text("所选工作树不可用。请刷新后选择现有工作区。", "The selected worktree is unavailable. Refresh and choose an existing workspace."));
+            return;
+          }
+          onChange({ workspace: ref.worktreePath, branch: ref.name, worktreePath: ref.worktreePath });
+        }}>
+        <option value="">{text("选择工作区", "Select workspace")}</option>
+        <option value="shared">{text("共享目录（非隔离）", "Shared checkout (not isolated)")}: {nativeProject.workspaceRoot}</option>
+        {missingSelection ? <option value={selection} disabled>{text("已记录工作区", "Recorded workspace")}: {value.branch} - {value.workspace}</option> : null}
+        {worktrees.map((ref) => <option key={ref.name} value={JSON.stringify([ref.name, ref.worktreePath])}>{ref.name} - {ref.worktreePath}</option>)}
+      </select>
+    </label>
+    {value ? <p className="break-all text-xs text-muted-foreground">{value.workspace}{value.branch ? ` (${value.branch})` : ""}</p> : null}
+    {!disabled ? <>
+      <div className="flex min-w-0 items-center gap-2">
+        <Input aria-label={text("筛选引用", "Filter refs")} placeholder={text("筛选引用", "Filter refs")} value={query} disabled={busy} onChange={(event) => setQuery(event.target.value)} />
+        <Button type="button" variant="outline" size="icon" title={text("刷新工作树和引用", "Refresh worktrees and refs")} aria-label={text("刷新工作树和引用", "Refresh worktrees and refs")} disabled={busy} onClick={() => refs.refresh()}><RefreshCw /></Button>
+        {refs.data?.nextCursor != null ? <Button type="button" variant="outline" disabled={busy || refs.isFetchingNextPage} onClick={() => refs.loadNext()}><ChevronDown />{text("更多引用", "More refs")}</Button> : null}
+      </div>
+      <div className="grid min-w-0 gap-2 sm:grid-cols-2">
+        <label className="min-w-0 text-sm">{text("基准引用", "Base ref")}
+          <select aria-label={text("基准引用", "Base ref")} className="mt-1 block w-full min-w-0 rounded border bg-background p-2" value={base} disabled={unavailable} onChange={(event) => setBase(event.target.value)}>
+            <option value="">{text("选择基准引用", "Select base ref")}</option>
+            {base && !refs.refs.some((ref) => ref.name === base) ? <option value={base} disabled>{base} ({text("尚未加载此引用", "not in loaded refs")})</option> : null}
+            {refs.refs.map((ref) => <option key={ref.name} value={ref.name}>{ref.name}</option>)}
+          </select>
+        </label>
+        <label className="min-w-0 text-sm">{text("新分支", "New branch")}
+          <Input aria-label={text("新分支", "New branch")} className="mt-1" value={branch} disabled={busy} onChange={(event) => setBranch(event.target.value)} />
+        </label>
+      </div>
+      <Button type="button" variant="outline" disabled={!canCreate} onClick={createSelectedWorktree}><GitBranchPlus />{busy ? text("正在创建工作树...", "Creating worktree...") : text("创建隔离工作树", "Create isolated worktree")}</Button>
+      <p className="text-xs text-muted-foreground">{text("不会运行初始化脚本或复制未提交更改。后续派发失败时，已创建工作树会保留。", "Setup scripts are not run and uncommitted changes are not copied. Created worktrees are retained if dispatch later fails.")}</p>
+    </> : null}
+    {refs.data === null && !refs.error && !disabled ? <p role="status" className="text-xs">{text("正在加载引用...", "Loading refs...")}</p> : null}
+    {error || sourceError ? <p role="alert" className="break-words text-sm text-destructive">{error || sourceError}</p> : null}
+  </div>;
+}
