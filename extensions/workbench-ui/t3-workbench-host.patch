diff --git a/apps/web/src/components/workbench/WorkbenchTransport.ts b/apps/web/src/components/workbench/WorkbenchTransport.ts
new file mode 100644
--- /dev/null
+++ b/apps/web/src/components/workbench/WorkbenchTransport.ts
@@ -0,0 +1,75 @@
+import type { WorkbenchRequest } from "@project-workbench/ui/model";
+
+const errorStatus: Record<string, number> = {
+  unauthorized: 401, forbidden: 403, not_found: 404, conflict: 409,
+  already_exists: 409, invalid_argument: 400, invalid_request: 400,
+  failed_precondition: 428, schema_mismatch: 428,
+};
+
+// Existing forms keep their request/receipt contract; no network fetch occurs here.
+export const requestWorkbench: WorkbenchRequest = async (url, init) => {
+  init?.signal?.throwIfAborted();
+  const bridge = window.desktopBridge;
+  if (!bridge?.readWorkbench) throw new Error("Local workbench bridge is unavailable");
+  const method = init?.method ?? "GET";
+  const body = init?.body === undefined ? undefined : JSON.parse(String(init.body));
+  const project = new Headers(init?.headers).get("X-Specgraph-Project");
+  const read = async (input: Parameters<NonNullable<typeof bridge.readWorkbench>>[0]) => {
+    try {
+      const data = await bridge.readWorkbench!(input);
+      init?.signal?.throwIfAborted();
+      return Response.json(data);
+    } catch (cause) {
+      init?.signal?.throwIfAborted();
+      const code = String(cause).match(/\b(unauthorized|forbidden|not_found|invalid_request|schema_mismatch):/)?.[1];
+      if (!code) throw cause;
+      return Response.json({ code, error: String(cause) }, { status: errorStatus[code]! });
+    }
+  };
+  if (url === "/workbench-api/api/auth/whoami" && method === "GET") return read({ resource: "operator-identity" });
+  if (url === "/workbench-api/api/auth/login" && method === "POST") return read({ resource: "operator-identity", credential: body.key });
+  if (url === "/workbench-api/api/auth/logout" && method === "POST") return read({ resource: "operator-signout" });
+  if (!project) throw new Error("Workbench project is required");
+  const spec = url.match(/^\/workbench-api\/wb\/specs\/([^/]+)$/);
+  if (spec && method === "GET") return read({ resource: "spec", project, slug: decodeURIComponent(spec[1]!) });
+  const changePreview = url.match(/^\/workbench-api\/loop\/specs\/([^/]+)\/change-preview$/);
+  if (changePreview && method === "GET") return read({ resource: "change-preview", project, slug: decodeURIComponent(changePreview[1]!) });
+  const knowledge = url.match(/^\/workbench-api\/knowledge\/(spec|decision|change)\/([^/]+)$/);
+  if (knowledge && method === "GET") return read({ resource: `knowledge-${knowledge[1]}` as "knowledge-spec" | "knowledge-decision" | "knowledge-change", project, slug: decodeURIComponent(knowledge[2]!) });
+  if (url.startsWith("/workbench-api/knowledge-search?") && method === "GET") return read({ resource: "knowledge-search", project, query: new URLSearchParams(url.split("?")[1]).get("q") ?? "" });
+  const nodeMarks = url.match(/^\/workbench-api\/node-marks\/([^/?]+)(?:\?(.*))?$/);
+  if (nodeMarks && method === "GET") return read({ resource: "node-mark-history", project, slug: decodeURIComponent(nodeMarks[1]!), cursor: new URLSearchParams(nodeMarks[2]).get("cursor") ?? "" });
+  const delivery = url.match(/^\/workbench-api\/loop\/deliveries\/([^/]+)(\/accept)?$/);
+  if (delivery && !delivery[2] && method === "GET") return read({ resource: "delivery", project, slug: decodeURIComponent(delivery[1]!) });
+  const run = url.match(/^\/workbench-api\/loop\/runs\/([^/]+)\/(context|dispatch)$/);
+  if (run && method === "GET") return read({ resource: run[2] === "context" ? "run-context" : "run-dispatch", project, slug: decodeURIComponent(run[1]!) });
+  const match = url.match(/^\/workbench-api\/loop\/specs\/(.+)\/(dependencies(?:\/remove)?|manual-complete|approve|subdivide|abandon)$/);
+  const runAction = url.match(/^\/workbench-api\/loop\/runs\/([^/]+)\/(bind|dispatch\/(?:authorize|resolve|confirm-stopped|cancel-preparation))$/);
+  const slug = nodeMarks ? decodeURIComponent(nodeMarks[1]!) : match ? decodeURIComponent(match[1]!) : runAction ? decodeURIComponent(runAction[1]!) : delivery ? decodeURIComponent(delivery[1]!) : undefined;
+  if (match?.[2] === "dependencies" && method === "GET") return read({ resource: "dependencies", project, slug: slug! });
+  const operation = url === "/workbench-api/specgraph.v1.SpecService/CreateSpec" ? "create-node"
+    : nodeMarks ? "set-node-mark"
+    : url === "/workbench-api/loop/deliveries" ? "submit-delivery"
+    : delivery?.[2] === "/accept" ? "review-delivery"
+    : url === "/workbench-api/loop/runs" ? "prepare-run"
+    : url === "/workbench-api/loop/preparations/abort" ? "abort-preparation"
+    : runAction?.[2] === "bind" ? "bind-run"
+    : runAction?.[2] === "dispatch/authorize" ? "authorize-run"
+    : runAction?.[2] === "dispatch/resolve" ? "resolve-run"
+    : runAction?.[2] === "dispatch/confirm-stopped" ? "confirm-run-stopped"
+    : runAction?.[2] === "dispatch/cancel-preparation" ? "cancel-preparation"
+    : url === "/workbench-api/wb/mail/setup" ? "mail-setup"
+    : match?.[2] === "dependencies" ? "add-dependency"
+    : match?.[2] === "dependencies/remove" ? "remove-dependency"
+    : match?.[2] === "approve" ? "approve-node"
+    : match?.[2] === "subdivide" ? "subdivide-node"
+    : match?.[2] === "abandon" ? "abandon-node"
+      : match?.[2] === "manual-complete" ? "manual-complete" : null;
+  if (method !== "POST" || !operation) throw new Error("Operation is not enabled on local IPC");
+  if (!bridge.commandWorkbench) throw new Error("Local workbench command bridge is unavailable");
+  const result = await bridge.commandWorkbench({ operation, project, ...(slug ? { slug } : {}), body });
+  init?.signal?.throwIfAborted();
+  if (result.error) return Response.json({ ...(result.data !== null && typeof result.data === "object" ? result.data : {}), code: result.error.code, error: result.error.message }, { status: errorStatus[result.error.code] ?? 500 });
+  if (result.data === undefined) throw new Error("Command response is missing its receipt");
+  return Response.json(result.data);
+};
