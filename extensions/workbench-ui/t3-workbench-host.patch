+import {
+  EnvironmentId, MessageId, ProjectId, ProviderInstanceId, ThreadId,
+  type OrchestrationSearchThreadsInput, type OrchestrationThreadShell,
+} from "@t3tools/contracts";
+import { expect, it } from "@effect/vitest";
+import * as Context from "effect/Context";
+import * as Effect from "effect/Effect";
+import * as Layer from "effect/Layer";
+import * as Option from "effect/Option";
+import * as Stream from "effect/Stream";
+import { Tool } from "effect/unstable/ai";
+
+import { ProjectionSnapshotQuery } from "../orchestration/Services/ProjectionSnapshotQuery.ts";
+import { PersistenceSqlError } from "../persistence/Errors.ts";
+import { McpInvocationContext, type McpInvocationScope } from "./McpInvocationContext.ts";
+import { WorkbenchKnowledgeHandlersLive, WorkbenchKnowledgeToolkit } from "./workbenchKnowledge.ts";
+
+const invocation: McpInvocationScope = {
+  environmentId: EnvironmentId.make("native-environment"),
+  threadId: ThreadId.make("native-thread"),
+  providerSessionId: "native-session",
+  providerInstanceId: ProviderInstanceId.make("codex"),
+  capabilities: new Set(),
+  issuedAt: 1,
+};
+const projectId = ProjectId.make("native-project");
+// Only project identity and archive state are consumed from the native shell.
+const thread = { projectId, archivedAt: null } as OrchestrationThreadShell;
+
+it.effect("reads the exact source message using authenticated project scope and explicit continuation", () => Effect.gen(function* () {
+  const source = { projectId, threadId: ThreadId.make("source-thread"), messageId: MessageId.make("source-message"),
+    source: "assistant" as const, text: "Original text", offset: 0, nextOffset: 6000,
+    createdAt: "2026-09-23T00:00:00.000Z", updatedAt: "2026-09-23T00:00:00.000Z" };
+  const snapshots = Layer.mock(ProjectionSnapshotQuery)({
+    getThreadShellById: () => Effect.succeed(Option.some(thread)),
+    readProjectConversationMessage: (input) => {
+      expect(input).toEqual({ projectId, threadId: source.threadId, messageId: source.messageId, offset: 0, maxCharacters: 6000 });
+      return Effect.succeed(Option.some(source));
+    },
+  });
+  const built = yield* WorkbenchKnowledgeToolkit.pipe(Effect.provide(WorkbenchKnowledgeHandlersLive.pipe(Layer.provide(snapshots))));
+  const results = yield* built.handle("workbench_read_conversation_message", { threadId: source.threadId, messageId: source.messageId, projectId: "forged" } as never).pipe(
+    Stream.unwrap, Stream.runCollect, Effect.provideService(McpInvocationContext, invocation),
+  );
+  expect(results.at(-1)?.result).toEqual(source);
+}));
+
+it.effect("derives conversation scope from authentication and ignores model identity", () => Effect.gen(function* () {
+  const requests: OrchestrationSearchThreadsInput[] = [];
+  const matches = [{
+    threadId: ThreadId.make("source-thread"), projectId, source: "user" as const,
+    snippet: "Original source excerpt", messageCreatedAt: "2026-09-23T00:00:00.000Z",
+  }];
+  const snapshots = Layer.mock(ProjectionSnapshotQuery)({
+    getThreadShellById: (id) => {
+      expect(id).toBe(invocation.threadId);
+      return Effect.succeed(Option.some(thread));
+    },
+    searchThreads: (input) => {
+      requests.push(input);
+      return Effect.succeed({ matches });
+    },
+  });
+  const built = yield* WorkbenchKnowledgeToolkit.pipe(
+    Effect.provide(WorkbenchKnowledgeHandlersLive.pipe(Layer.provide(snapshots))),
+  );
+  const call = (payload: unknown) => built.handle("workbench_search_conversations", payload as never).pipe(
+    Stream.unwrap, Stream.runCollect, Effect.provideService(McpInvocationContext, invocation),
+  );
+  const result = yield* call({ query: "source" });
+  expect(requests).toEqual([{ projectId, query: "source", includeArchived: true, limit: 20 }]);
+  expect(result.at(-1)?.result).toEqual({
+    scope: "t3-project-conversations", projectId, matches, limit: 20,
+    includeArchived: true, oneMatchPerThread: true,
+  });
+  yield* call({ query: "source", includeArchived: false, limit: 1 });
+  expect(requests[1]).toEqual({ projectId, query: "source", includeArchived: false, limit: 1 });
+  for (const field of ["projectId", "threadId", "environmentId", "providerSessionId", "unknown"]) {
+    yield* call({ query: "source", [field]: "forged" });
+    expect(requests.at(-1)).toEqual({ projectId, query: "source", includeArchived: true, limit: 20 });
+  }
+  expect(requests).toHaveLength(7);
+  const tool = WorkbenchKnowledgeToolkit.tools.workbench_search_conversations;
+  expect(Object.keys(Tool.getJsonSchema(tool).properties ?? {})).toEqual(["query", "includeArchived", "limit"]);
+  expect(Context.get(tool.annotations, Tool.Readonly)).toBe(true);
+  expect(Context.get(tool.annotations, Tool.Destructive)).toBe(false);
+  expect(Context.get(tool.annotations, Tool.Idempotent)).toBe(true);
+  expect(Context.get(tool.annotations, Tool.OpenWorld)).toBe(false);
+}));
+
+it.effect("fails explicitly for missing or archived invocation and failed search", () => Effect.gen(function* () {
+  for (const value of [null, { ...thread, archivedAt: "2026-09-23T00:00:00.000Z" }, thread]) {
+    const snapshots = Layer.mock(ProjectionSnapshotQuery)({
+      getThreadShellById: () => Effect.succeed(Option.fromNullishOr(value)),
+      searchThreads: () => Effect.fail(new PersistenceSqlError({ operation: "search fixture", cause: "unavailable" })),
+    });
+    const built = yield* WorkbenchKnowledgeToolkit.pipe(
+      Effect.provide(WorkbenchKnowledgeHandlersLive.pipe(Layer.provide(snapshots))),
+    );
+    const failure = yield* built.handle("workbench_search_conversations", { query: "source" }).pipe(
+      Stream.unwrap, Stream.runCollect, Effect.provideService(McpInvocationContext, invocation), Effect.flip,
+    );
+    expect(failure.message).toBe(value === thread
+      ? "Conversation search failed"
+      : "Conversation search requires an active invoking thread");
+  }
+}));
diff --git a/apps/server/src/mcp/workbenchKnowledge.ts b/apps/server/src/mcp/workbenchKnowledge.ts
new file mode 100644
index 00000000..f024cac1
--- /dev/null
+++ b/apps/server/src/mcp/workbenchKnowledge.ts
@@ -0,0 +1,104 @@
+import { IsoDateTime, MessageId, OrchestrationSearchThreadsInput, OrchestrationSearchThreadsResult, ProjectId, ThreadId } from "@t3tools/contracts";
+import * as Effect from "effect/Effect";
+import * as Layer from "effect/Layer";
+import * as Option from "effect/Option";
+import * as Schema from "effect/Schema";
+import { McpServer, Tool, Toolkit } from "effect/unstable/ai";
+
+import { ProjectionSnapshotQuery } from "../orchestration/Services/ProjectionSnapshotQuery.ts";
+import { McpInvocationContext } from "./McpInvocationContext.ts";
+
+export class WorkbenchKnowledgeError extends Schema.TaggedError<WorkbenchKnowledgeError>()(
+  "WorkbenchKnowledgeError",
+  { message: Schema.String },
+) {}
+
+const SearchConversations = Tool.make("workbench_search_conversations", {
+  description:
+    "Search user messages and canonical assistant outputs in this authenticated thread's native project. Includes archived conversations by default. Returns one matching excerpt per thread, not full conversations or files. The project is derived from the authenticated thread, never supplied by the model.",
+  parameters: Schema.Struct({
+    query: OrchestrationSearchThreadsInput.fields.query,
+    includeArchived: Schema.optionalKey(Schema.Boolean),
+    limit: OrchestrationSearchThreadsInput.fields.limit,
+  }),
+  success: Schema.Struct({
+    scope: Schema.Literal("t3-project-conversations"),
+    projectId: ProjectId,
+    matches: OrchestrationSearchThreadsResult.fields.matches,
+    limit: Schema.Int,
+    includeArchived: Schema.Boolean,
+    oneMatchPerThread: Schema.Literal(true),
+  }),
+  failure: WorkbenchKnowledgeError,
+  dependencies: [McpInvocationContext],
+})
+  .annotate(Tool.Readonly, true)
+  .annotate(Tool.Destructive, false)
+  .annotate(Tool.Idempotent, true)
+  .annotate(Tool.OpenWorld, false);
+
+const ReadConversationMessage = Tool.make("workbench_read_conversation_message", {
+  description: "Read original saved user/final assistant text from the same native project as the authenticated invoking thread. Use the exact threadId and messageId returned by workbench_search_conversations, never infer identity from timestamps. Reads one message in Unicode-character chunks; continue using nextOffset until null. Archived sources are allowed, deleted/streaming/reasoning/tool messages are excluded. updatedAt identifies the current source, not a frozen historical snapshot.",
+  parameters: Schema.Struct({
+    threadId: ThreadId, messageId: MessageId,
+    offset: Schema.optionalKey(Schema.Int.check(Schema.isBetween({ minimum: 0, maximum: Number.MAX_SAFE_INTEGER }))),
+    maxCharacters: Schema.optionalKey(Schema.Int.check(Schema.isBetween({ minimum: 1, maximum: 12000 }))),
+  }),
+  success: Schema.Struct({
+    projectId: ProjectId, threadId: ThreadId, messageId: MessageId,
+    source: Schema.Literals(["user", "assistant"]), createdAt: IsoDateTime, updatedAt: IsoDateTime,
+    text: Schema.String, offset: Schema.Int, nextOffset: Schema.NullOr(Schema.Int),
+  }),
+  failure: WorkbenchKnowledgeError,
+  dependencies: [McpInvocationContext],
+}).annotate(Tool.Readonly, true).annotate(Tool.Destructive, false)
+  .annotate(Tool.Idempotent, true).annotate(Tool.OpenWorld, false);
+
+export const WorkbenchKnowledgeToolkit = Toolkit.make(SearchConversations, ReadConversationMessage);
+
+export const WorkbenchKnowledgeHandlersLive = WorkbenchKnowledgeToolkit.toLayer(
+  Effect.gen(function* () {
+    const snapshots = yield* ProjectionSnapshotQuery;
+    const invokingProject = Effect.gen(function* () {
+      const invocation = yield* McpInvocationContext;
+      const thread = yield* snapshots.getThreadShellById(invocation.threadId).pipe(
+        Effect.mapError(() => new WorkbenchKnowledgeError({ message: "Conversation search thread lookup failed" })),
+      );
+      if (Option.isNone(thread) || thread.value.archivedAt !== null) {
+        return yield* new WorkbenchKnowledgeError({ message: "Conversation search requires an active invoking thread" });
+      }
+      return thread.value.projectId;
+    });
+    return WorkbenchKnowledgeToolkit.of({
+      workbench_search_conversations: Effect.fn("workbench_search_conversations")(function* (input) {
+        const projectId = yield* invokingProject;
+        const limit = input.limit ?? 20;
+        const includeArchived = input.includeArchived ?? true;
+        const result = yield* snapshots.searchThreads({ projectId, query: input.query, includeArchived, limit }).pipe(
+          Effect.mapError(() => new WorkbenchKnowledgeError({ message: "Conversation search failed" })),
+        );
+        return {
+          scope: "t3-project-conversations" as const,
+          projectId,
+          matches: result.matches,
+          limit,
+          includeArchived,
+          oneMatchPerThread: true as const,
+        };
+      }),
+      workbench_read_conversation_message: Effect.fn("workbench_read_conversation_message")(function* (input) {
+        const projectId = yield* invokingProject;
+        const result = yield* snapshots.readProjectConversationMessage({
+          projectId, threadId: input.threadId, messageId: input.messageId,
+          offset: input.offset ?? 0, maxCharacters: input.maxCharacters ?? 6000,
+        }).pipe(Effect.mapError(() => new WorkbenchKnowledgeError({ message: "Conversation source read failed" })));
+        if (Option.isNone(result)) return yield* new WorkbenchKnowledgeError({ message: "Source message is unavailable in this project" });
+        return result.value;
+      }),
+    });
+  }),
+);
+
+export const WorkbenchKnowledgeRegistrationLive = McpServer.toolkit(WorkbenchKnowledgeToolkit).pipe(
+  Layer.provide(WorkbenchKnowledgeHandlersLive),
+);
