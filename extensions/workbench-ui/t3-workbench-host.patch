+  ready: ["空闲", "Idle"],
+};
+
+const assignmentLabels: Record<string, readonly [string, string]> = {
+  manager: ["项目管理", "Project management"], knowledge: ["知识维护", "Knowledge stewardship"],
+  executor: ["设计与执行", "Design and execution"], reviewer: ["审核", "Review"],
+};
+
+function SessionRow({ run, thread, siblingRuns, project, onChanged, request }: { run: WorkbenchRun; thread: EnvironmentThreadShell; siblingRuns: readonly WorkbenchRun[]; project: string; onChanged: () => void; request?: WorkbenchRequest }) {
+  const { language } = useI18n();
+  const zh = language === "zh";
+  const [inspectTurns, setInspectTurns] = useState(false);
+  const detail = useThreadDetail(inspectTurns && run.dispatchMessageId ? scopeThreadRef(thread.environmentId, thread.id) : null);
+  const turnIds = ownedWorkbenchTurnIds(run.id, siblingRuns, detail?.activities ?? []);
+  const compactions = linkedWorkbenchCompactions(run.id, siblingRuns, detail?.activities ?? []);
+  const usage = workbenchTurnUsage(detail?.activities ?? []);
+  const consulted = consultedWorkbenchSources(run.id, thread.projectId, siblingRuns, detail?.activities ?? []);
+  const checkpoints = linkedWorkbenchCheckpoints(run.id, siblingRuns, detail?.activities ?? [], detail?.checkpoints ?? []);
+  const nowMinute = useNowMinute();
+  const elapsed = thread.latestTurn && turnIds.includes(thread.latestTurn.turnId)
+    ? elapsedTurnMinutes(thread.latestTurn, Date.parse(`${nowMinute}:00Z`)) : null;
+  const shell = useAtomValue(environmentShell.stateValueAtom(thread.environmentId));
+  const { presentationById } = useEnvironments();
+  const environment = presentationById.get(thread.environmentId);
+  const live = shell.status === "live" && environment?.connection.phase === "connected";
+  const status = resolveSidebarThreadStatus(thread);
+  const statusLabel = statusLabels[status][zh ? 0 : 1];
+  return (
