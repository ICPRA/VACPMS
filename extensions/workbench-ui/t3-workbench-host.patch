+            : turnIds.length === 0 ? <p>{zh ? "当前会话记录中没有可唯一归属的轮次" : "No uniquely attributable turn in the current session records"}</p>
+            : <ul>{turnIds.map((id) => {
+              const tokens = usage.get(id);
+              return <li key={id} className="break-all">{id}
+                <p>{zh ? "主Agent token" : "Main-agent tokens"}: {tokens
+                  ? `${zh ? "输入" : "Input"} ${tokens.inputTokens ?? "?"} / ${zh ? "输出" : "Output"} ${tokens.outputTokens ?? "?"} (${tokens.usageStatus === "complete" ? (zh ? "完整" : "complete") : (zh ? "部分或不可用" : "partial or unavailable")})`
+                  : (zh ? "未提供" : "Not provided")}</p>
+              </li>;
