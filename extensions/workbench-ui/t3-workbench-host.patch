+import { resolveSidebarThreadStatus, type SidebarThreadStatus } from "../Sidebar.logic";
+import { consultedWorkbenchRecords, consultedWorkbenchSources, elapsedTurnMinutes, loadedWorkbenchUsage, linkedWorkbenchCheckpoints, linkedWorkbenchCompactions, ownedWorkbenchTurnIds, matchWorkbenchRun, workbenchTurnUsage } from "./WorkbenchSessions.logic";
+import type { WorkbenchRequest, WorkbenchRun } from "./workbenchModel";
+import { WorkbenchDeliverySubmission } from "./WorkbenchDeliverySubmission";
+import { WorkbenchProgramRunRow } from "./WorkbenchProgram";
+import { RunHarness } from "@project-workbench/ui/run-harness";
+
+const statusLabels: Record<SidebarThreadStatus, readonly [string, string]> = {
+  approval: ["等待审批", "Awaiting approval"],
+  input: ["等待输入", "Awaiting input"],
+  working: ["正在执行", "Working"],
+  monitoring: ["正在监视", "Monitoring"],
+  failed: ["运行失败", "Run failed"],
+  ready: ["空闲", "Idle"],
+};
+
+const assignmentLabels: Record<string, readonly [string, string]> = {
+  manager: ["项目管理", "Project management"], knowledge: ["知识维护", "Knowledge stewardship"],
+  executor: ["设计与执行", "Design and execution"], reviewer: ["审核", "Review"],
+};
+
+function SessionRow({ run, thread, siblingRuns, project, onChanged, request }: { run: WorkbenchRun; thread: EnvironmentThreadShell; siblingRuns: readonly WorkbenchRun[]; project: string; onChanged: () => void; request?: WorkbenchRequest }) {
+  const { language } = useI18n();
+  const zh = language === "zh";
+  const [inspectTurns, setInspectTurns] = useState(false);
+  const detail = useThreadDetail(inspectTurns && run.dispatchMessageId ? scopeThreadRef(thread.environmentId, thread.id) : null);
+  const turnIds = ownedWorkbenchTurnIds(run.id, siblingRuns, detail?.activities ?? []);
+  const compactions = linkedWorkbenchCompactions(run.id, siblingRuns, detail?.activities ?? []);
+  const usage = workbenchTurnUsage(detail?.activities ?? []);
+  const loadedUsage = loadedWorkbenchUsage(turnIds, usage);
+  const consulted = consultedWorkbenchSources(run.id, thread.projectId, siblingRuns, detail?.activities ?? []);
+  const consultedRecords = consultedWorkbenchRecords(run.id, project, thread, siblingRuns, detail?.activities ?? []);
+  const checkpoints = linkedWorkbenchCheckpoints(run.id, siblingRuns, detail?.activities ?? [], detail?.checkpoints ?? []);
+  const nowMinute = useNowMinute();
+  const elapsed = thread.latestTurn && turnIds.includes(thread.latestTurn.turnId)
+    ? elapsedTurnMinutes(thread.latestTurn, Date.parse(`${nowMinute}:00Z`)) : null;
+  const shell = useAtomValue(environmentShell.stateValueAtom(thread.environmentId));
+  const { presentationById } = useEnvironments();
+  const environment = presentationById.get(thread.environmentId);
+  const live = shell.status === "live" && environment?.connection.phase === "connected";
+  const status = resolveSidebarThreadStatus(thread);
+  const statusLabel = statusLabels[status][zh ? 0 : 1];
+  return (
+    <article className="grid min-w-0 gap-3 border-b py-4 md:grid-cols-[minmax(0,1fr)_auto]">
+      <div className="min-w-0 space-y-1">
+        <Link
+          to="/$environmentId/$threadId"
+          params={buildThreadRouteParams({
+            environmentId: thread.environmentId,
+            threadId: thread.id,
+          })}
+          className="inline-flex max-w-full items-start gap-1 break-words font-medium text-primary hover:underline"
+        >
+          <span className="min-w-0 break-words [overflow-wrap:anywhere]">{thread.title}</span>
+          <ArrowUpRight className="mt-0.5 size-4 shrink-0" aria-hidden="true" />
+        </Link>
+        <div>
+          <Link to="/$environmentId/$threadId"
+            params={buildThreadRouteParams({ environmentId: thread.environmentId, threadId: thread.id })}
+            onClick={() => useRightPanelStore.getState().open(scopeThreadRef(thread.environmentId, thread.id), "diff")}
+            className="wb-button">
+            <GitCompareArrows size={14} aria-hidden="true" />{zh ? "工作区改动" : "Workspace changes"}
+          </Link>
+        </div>
+        <p className="break-all text-xs text-muted-foreground">
+          {run.taskSlug} · {thread.modelSelection.model}
+        </p>
+        <p className="break-all text-xs text-muted-foreground">{run.workspace}</p>
+        <p className="text-xs text-muted-foreground">{zh ? "派单职责" : "Assigned responsibility"}: {run.assignmentRole ? (assignmentLabels[run.assignmentRole]?.[zh ? 0 : 1] ?? run.assignmentRole) : (zh ? "未记录" : "Not recorded")}</p>
