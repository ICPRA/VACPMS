+          {!checkpoints.length && <p>{zh ? "当前记录中没有可唯一关联的检查点。" : "No uniquely linked checkpoint in loaded records."}</p>}
+          {checkpoints.length > 0 && <p>{zh ? "T3工作区检查点，不等于该节点独占修改或已合入Git提交。" : "T3 workspace checkpoints, not proof of exclusive node authorship or merged Git commits."}</p>}
+          <h4>{zh ? "自动关联的原文片段读取" : "Automatically linked source reads"}</h4>
+          {consulted.sources.map((source) => <div key={source.eventId} className="border-t py-2">
+            <Link to="/$environmentId/$threadId" params={buildThreadRouteParams({ environmentId: thread.environmentId, threadId: source.threadId })} className="underline break-all">{source.threadId} · {source.messageId}</Link>
+            <p>{source.source} · {source.offset} → {source.nextOffset ?? (zh ? "末尾" : "end")} · {source.updatedAt}</p>
+            <p>{zh ? "返回片段时间" : "Read receipt time"}: {source.readAt}</p>
+          </div>)}
+          {consulted.ambiguousCount > 0 && <p>{zh ? "部分读取对应多个执行，未分配给节点。" : "Some reads map to multiple runs; node attribution is unresolved."}</p>}
+          {!consulted.sources.length && <p>{zh ? "当前活动中未取得可唯一关联的来源，不代表没有读取。" : "No uniquely attributable source in loaded activities; this does not establish that no read occurred."}</p>}
+          {consulted.sources.length > 0 && <p>{zh ? "仅证明工具返回了这些片段，不代表模型采纳、全文读完或审核通过。" : "These receipts establish returned fragments, not adoption, complete reading or approval."}</p>}
+        </details>
+        <p className="text-xs text-muted-foreground">
