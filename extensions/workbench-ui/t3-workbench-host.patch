+          </details>
+          <h4>{zh ? "关联轮次的文件差异" : "Files changed in linked turns"}</h4>
+          {checkpoints.map((checkpoint) => <div key={checkpoint.turnId} className="border-t py-2">
+            <p className="break-all">{checkpoint.checkpointRef} · {checkpoint.status} · {checkpoint.completedAt}</p>
+            {checkpoint.files.map((file) => <p key={file.path} className="break-all">
